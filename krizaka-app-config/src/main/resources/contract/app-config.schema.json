{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krizaka.com/contracts/app-config.schema.json",
  "title": "Krizaka app-config payload",
  "description": "The body of GET /api/v1/app-config and the appConfig member of a 426 Upgrade Required problem. Shared by the Java building block krizaka-app-config and the TypeScript package @krizaka/app-config.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "minSupportedVersion",
    "latestVersion",
    "updateMode",
    "storeUrl",
    "maintenance",
    "contract",
    "flags",
    "message",
    "locale"
  ],
  "properties": {
    "platform": { "enum": ["ios", "android", "macos", "windows", "linux", "web"] },
    "minSupportedVersion": { "$ref": "#/$defs/version" },
    "latestVersion": { "$ref": "#/$defs/version" },
    "updateMode": { "enum": ["none", "soft", "force"] },
    "storeUrl": { "type": ["string", "null"], "pattern": "^https://" },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "message"],
      "properties": {
        "on": { "type": "boolean" },
        "message": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "sunset"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "sunset": { "type": ["string", "null"], "format": "date" }
      }
    },
    "flags": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": ["boolean", "number", "string"] }
    },
    "message": { "type": ["string", "null"], "maxLength": 500 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}$" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
