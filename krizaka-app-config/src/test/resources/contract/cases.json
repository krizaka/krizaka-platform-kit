{
  "description": "One fixture, two implementations: krizaka-app-config (Java) and @krizaka/app-config (TypeScript) both evaluate every case and must agree. 'config' is the admin API shape; 'expect.payload' is a subset of the public payload; 'expect.guard' is what the 426 filter does (status, code of the problem, Deprecation and Sunset headers).",
  "cases": [
    {
      "name": "permissive defaults let everybody in",
      "platform": "ios",
      "config": {
        "minSupportedVersion": "0.0.0",
        "latestVersion": "0.0.0",
        "updateOverride": null,
        "storeUrl": null,
        "maintenanceOn": false,
        "maintenanceMessage": {},
        "message": {},
        "contractMin": 1,
        "contractMax": 1,
        "contractSunset": null,
        "flags": {}
      },
      "client": {
        "version": "1.0.0",
        "contract": 1
      },
      "expect": {
        "payload": {
          "updateMode": "none",
          "minSupportedVersion": "0.0.0"
        },
        "guard": {
          "status": 200
        }
      }
    },
    {
      "name": "no version sent means no prompt",
      "platform": "ios",
      "config": {
        "minSupportedVersion": "2.0.0",
        "latestVersion": "3.0.0",
        "updateOverride": null,
        "storeUrl": null,
        "maintenanceOn": false,
        "maintenanceMessage": {},
        "message": {},
        "contractMin": 1,
        "contractMax": 1,
        "contractSunset": null,
        "flags": {}
      },
      "client": {},
      "expect": {
        "payload": {
          "updateMode": "none"
        },
        "guard": {
          "status": 200
        }
      }
    },
    {
      "name": "below latest, above minimum is a soft update",
      "platform": "ios",
      "config": {
        "minSupportedVersion": "1.2.0",
        "latestVersion": "1.4.0",
