          "en": "A new version is available.",
          "fr": "Une nouvelle version est disponible."
        },
        "contractMin": 1,
        "contractMax": 1,
        "contractSunset": null,
        "flags": {}
      },
      "client": {
        "version": "1.3.0",
        "contract": 1
      },
      "expect": {
        "payload": {
          "updateMode": "soft",
          "message": "A new version is available.",
          "storeUrl": "https://apps.apple.com/app/id1",
          "locale": "en"
