<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!-- Built on the Krizaka build (krizaka/krizaka-build): Maven Central metadata, Java 21
         conventions and the signed release. Inside a workspace that clones krizaka-build next to
         this repository the relativePath resolves it from source; anywhere else it comes from
         Maven Central. -->
    <parent>
        <groupId>com.krizaka</groupId>
        <artifactId>krizaka-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../krizaka-build/krizaka-parent/pom.xml</relativePath>
    </parent>

    <artifactId>krizaka-notifications</artifactId>
    <packaging>pom</packaging>
    <name>Krizaka Notifications</name>
    <description>Channel-based notification delivery for any Krizaka application: e-mail (SMTP), SMS (Twilio) and webhooks behind one DeliveryClient port, driven by platform events (user registered, password reset) or explicit notification requests over AMQP.</description>
    <url>https://github.com/krizaka/krizaka-notifications</url>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/krizaka/krizaka-notifications</url>
        <connection>scm:git:https://github.com/krizaka/krizaka-notifications.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/krizaka-notifications.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/krizaka/krizaka-notifications/issues</url>
    </issueManagement>

    <properties>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <modules>
        <module>krizaka-notifications-api</module>
        <module>krizaka-notifications-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The other Krizaka artifacts, at this repository's own version. -->
            <dependency>
                <groupId>com.krizaka</groupId>
                <artifactId>krizaka-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <!-- /actuator/info says which build is running. -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
